def update_zen_browser(opacity: float, dry_run: bool = False) -> List[str]:
    updated = []
    alpha = f"{opacity:.2f}"
    color_val = f"rgba(20, 20, 30, {alpha})"

    zen_dirs = [
        CONFIG_DIR / "zen",
        Path.home() / ".zen",
        CONFIG_DIR / "zen-alpha",
    ]

    css_content = f"""{MARKER_START}
/* Generated by set-opacity for Zen Browser */
:root,
#main-window,
body,
.zen-browser-generic-background {{
    --zen-main-browser-background: {color_val} !important;
    --mod-sameerasw-zen_transparency_color: {color_val} !important;
}}

#main-window,
#browser,
#zen-main-app-wrapper,
#navigator-toolbox,
#tabbrowser-tabpanels,
#sidebar-box,
.zen-browser-generic-background {{
    background-color: {color_val} !important;
}}
{MARKER_END}"""

    user_js_snippet = f"""{MARKER_HASH_START}
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("mod.sameerasw.zen_bg_color_enabled", true);
user_pref("mod.sameerasw.zen_transparency_color", "{color_val}");
