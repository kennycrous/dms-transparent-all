#!/usr/bin/env python3
"""
set-opacity: Unified Window Background Transparency Manager for CachyOS + Niri/Hyprland + DMS
Automates background transparency for GTK3/4, Terminal Emulators, VS Code, Firefox, Zen Browser, DMS UI, and Niri/Hyprland Compositor Window Rules.
"""

import os
import sys
import re
import shutil
import subprocess
import argparse
from pathlib import Path
from typing import Optional, Dict, List

# Presets mapping
PRESETS: Dict[str, float] = {
    "opaque": 1.0,
    "solid": 1.0,
    "high": 0.90,
    "medium": 0.85,
    "translucent": 0.75,
    "low": 0.65,
    "transparent": 0.50,
}

CONFIG_DIR = Path.home() / ".config"

# Marker strings for non-destructive updates
MARKER_START = "/* BEGIN DMS TRANSPARENCY */"
MARKER_END = "/* END DMS TRANSPARENCY */"
MARKER_HASH_START = "# BEGIN DMS TRANSPARENCY"
MARKER_HASH_END = "# END DMS TRANSPARENCY"
MARKER_KDL_START = "// BEGIN DMS TRANSPARENCY"
MARKER_KDL_END = "// END DMS TRANSPARENCY"
MARKER_LUA_START = "-- BEGIN DMS TRANSPARENCY"
MARKER_LUA_END = "-- END DMS TRANSPARENCY"

# Windows the compositor opacity rule never applies to, on both Niri and Hyprland.
# Regexes are matched against the Niri app-id / Hyprland class.
EXCLUDED_APP_PATTERNS: List[str] = [
    # Browsers
    r"^firefox$",
    r"^org\.mozilla\.firefox$",
    r"^zen$",
    r"^app\.zen_browser\.zen$",
    r"^librewolf$",
    r"^floorp$",
    r"^google-chrome$",
    r"^com\.google\.Chrome$",
    r"^chrome-.*",
    r"^chromium$",
    r"^brave-browser$",
    r"^vivaldi-stable$",
    # Game launchers & games
    r"^steam$",
    r"^steam_app_\d+$",
    r"^lutris$",
    r"^net\.lutris\.Lutris$",
    r"^heroic$",
    r"^com\.heroicgameslauncher\.hgl$",
    r"^com\.usebottles\.bottles$",
    r"^faugus-launcher$",
    r"^io\.github\.Faugus\.faugus-launcher$",
    r"^org\.prismlauncher\.PrismLauncher$",
    # DMS settings window (part of the shell)
    r"^com\.danklinux\.dms$",
]



def parse_opacity_value(val_str: str) -> float:
    """Parse string input (preset, percentage, or float) to a float between 0.0 and 1.0."""
    val_clean = val_str.strip().lower()

    if val_clean in PRESETS:
        return PRESETS[val_clean]

    if val_clean.endswith("%"):
        try:
            num = float(val_clean[:-1])
            if 0 <= num <= 100:
                return num / 100.0
        except ValueError:
            pass

    try:
        num = float(val_clean)
        if 0.0 <= num <= 1.0:
            return num
        elif 1.0 < num <= 100.0:
            return num / 100.0
    except ValueError:
        pass

    print(f"Error: Invalid opacity value '{val_str}'. Use a decimal (0.0 - 1.0), percentage (e.g. 85%), or preset ({', '.join(PRESETS.keys())}).", file=sys.stderr)
    sys.exit(1)


def create_backup(file_path: Path):
    """Creates a backup .bak file if not already backed up."""
    if file_path.exists():
        bak_path = file_path.with_suffix(file_path.suffix + ".bak")
        if not bak_path.exists():
            shutil.copy2(file_path, bak_path)


def write_file_safe(file_path: Path, content: str, dry_run: bool = False) -> bool:
    """Safely writes content to file, creating parent directories if needed."""
    if dry_run:
        print(f"[DRY-RUN] Would write to {file_path}:\n{content.strip()}\n")
        return True

    file_path.parent.mkdir(parents=True, exist_ok=True)
    create_backup(file_path)
    file_path.write_text(content, encoding="utf-8")
    return True


# ==========================================
# GTK 3 & GTK 4 HANDLER (DMS Settings / GTK)
# ==========================================
def update_gtk_css(opacity: float, dry_run: bool = False) -> List[str]:
    updated = []
    alpha = f"{opacity:.2f}"

    css_content = f"""{MARKER_START}
/* Generated by set-opacity */
@define-color window_bg_color rgba(20, 20, 30, {alpha});
@define-color theme_bg_color rgba(20, 20, 30, {alpha});

window,
window.background,
.background,
headerbar,
.titlebar,
dialog,
messagedialog {{
    background-color: rgba(20, 20, 30, {alpha}) !important;
}}

/* Ensure popovers and menus remain legible */
popover,
popover.background,
menu,
.menu {{
    background-color: rgba(20, 20, 30, max(0.85, {alpha})) !important;
}}
{MARKER_END}"""

    for gtk_ver in ["gtk-3.0", "gtk-4.0"]:
        css_file = CONFIG_DIR / gtk_ver / "gtk.css"
        existing = css_file.read_text(encoding="utf-8") if css_file.exists() else ""

        pattern = re.compile(rf"{re.escape(MARKER_START)}.*?{re.escape(MARKER_END)}", re.DOTALL)
        clean_css = pattern.sub("", existing).strip()

        new_css = (clean_css + "\n\n" + css_content).strip() + "\n"
        if write_file_safe(css_file, new_css, dry_run):
            updated.append(f"GTK ({gtk_ver})")

    return updated



# ==========================================
# NIRI COMPOSITOR WINDOW RULES HANDLER
# ==========================================
def update_niri(opacity: float, dry_run: bool = False) -> Optional[str]:
    niri_dir = CONFIG_DIR / "niri"
    if not niri_dir.exists():
        return None

    # Ensure dms/windowrules.kdl is included in main config.kdl
    niri_config = niri_dir / "config.kdl"
    if niri_config.exists():
        cfg_text = niri_config.read_text(encoding="utf-8")
        if "dms/windowrules.kdl" not in cfg_text:
            if not dry_run:
                create_backup(niri_config)
                niri_config.write_text(cfg_text.strip() + '\ninclude optional=true "dms/windowrules.kdl"\n', encoding="utf-8")

    target_file = niri_dir / "dms" / "windowrules.kdl"
    existing = target_file.read_text(encoding="utf-8") if target_file.exists() else ""
    alpha_str = f"{opacity:.2f}"

    exclude_lines = "\n".join([f'    exclude app-id=r#"{p}"#' for p in EXCLUDED_APP_PATTERNS])

    block = f"""{MARKER_KDL_START}
window-rule {{
    match app-id="code"
    match app-id="code-url-handler"
    match app-id="Code"
    draw-border-with-background false
    opacity {alpha_str}
}}

window-rule {{
{exclude_lines}
    opacity {alpha_str}
}}
{MARKER_KDL_END}"""

    pattern = re.compile(rf"{re.escape(MARKER_KDL_START)}.*?{re.escape(MARKER_KDL_END)}", re.DOTALL)

    if pattern.search(existing):
        new_content = pattern.sub(lambda _: block, existing)
    else:
        new_content = (existing.strip() + "\n\n" + block).strip() + "\n"

    write_file_safe(target_file, new_content, dry_run)

    if not dry_run:
        try:
            subprocess.run(["niri", "msg", "action", "load-config-file"], stderr=subprocess.DEVNULL)
        except Exception:
            pass

    return f"Niri Compositor Window Rules ({target_file.name})"


# ==========================================
# HYPRLAND COMPOSITOR WINDOW RULES HANDLER
# ==========================================
def update_hyprland(opacity: float, dry_run: bool = False) -> Optional[str]:
    hypr_dir = CONFIG_DIR / "hypr"
    hypr_config = hypr_dir / "hyprland.lua"
    if not hypr_config.exists():
        return None

    # Hyprland applies rules top to bottom and the last match wins, so dms.opacity is required
    # before the DMS window rules: any app with its own opacity rule keeps it.
    require_line = 'require("dms.opacity")'
    cfg_text = hypr_config.read_text(encoding="utf-8")
    if require_line not in cfg_text:
        anchor = re.search(r"^-- DMS_WINDOWRULES_BEGIN|^require\(\"dms\.", cfg_text, re.MULTILINE)
        if anchor:
            new_cfg = cfg_text[:anchor.start()] + require_line + "\n\n" + cfg_text[anchor.start():]
        else:
            new_cfg = cfg_text.rstrip() + "\n\n" + require_line + "\n"
        if dry_run:
            print(f"[DRY-RUN] Would add {require_line} to {hypr_config}\n")
        else:
            create_backup(hypr_config)
            hypr_config.write_text(new_cfg, encoding="utf-8")

    target_file = hypr_dir / "dms" / "opacity.lua"
    alpha_str = f"{opacity:.2f}"
    excluded_regex = "|".join(EXCLUDED_APP_PATTERNS)
    lua_excluded = '"' + excluded_regex.replace("\\", "\\\\") + '"'

    content = f"""{MARKER_LUA_START}
-- Generated by set-opacity
hl.window_rule({{ match = {{ class = ".*" }}, opacity = "{alpha_str}" }})
-- Excluded apps stay opaque (last matching rule wins)
hl.window_rule({{ match = {{ class = {lua_excluded} }}, opacity = "1.0" }})
{MARKER_LUA_END}
"""

    # Hyprland reloads the config itself when DMS-managed files change, so no explicit reload here.
    write_file_safe(target_file, content, dry_run)

    return f"Hyprland Compositor Window Rules ({target_file.name})"



# ==========================================
# VS CODE HANDLER
# ==========================================
def update_vscode(opacity: float, dry_run: bool = False) -> List[str]:
    updated = []

    vscode_dirs = [
        CONFIG_DIR / "Code" / "User",
        CONFIG_DIR / "VSCodium" / "User",
        CONFIG_DIR / "Cursor" / "User",
    ]

    for vdir in vscode_dirs:
        settings_file = vdir / "settings.json"
        if not vdir.exists():
            continue

        existing = settings_file.read_text(encoding="utf-8") if settings_file.exists() else "{}\n"

        # Background transparency is handled by Niri compositor window rules.
        # Remove #00000000 workbench.colorCustomizations so VS Code retains its active colour theme.
        pattern = re.compile(r',?\s*"workbench\.colorCustomizations"\s*:\s*\{[^}]*\}', re.DOTALL)
        if pattern.search(existing):
            new_content = pattern.sub("", existing)
            # Clean up trailing comma if workbench.colorCustomizations was the last key before closing brace
            new_content = re.sub(r',(\s*\n\s*\})', r'\1', new_content)
            if write_file_safe(settings_file, new_content, dry_run):
                updated.append(f"VS Code ({vdir.parent.name}) - colour theme background restored")
        else:
            updated.append(f"VS Code ({vdir.parent.name}) - managed via compositor window rules")

    return updated


