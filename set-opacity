    ]
    seen_ff_profiles = set()
    for ff_base in firefox_dirs:
        if ff_base.exists():
            for p in ff_base.iterdir():
                if not p.is_dir():
                    continue
                name_lower = p.name.lower()
                if "backup" in name_lower or "crashrecovery" in name_lower or "back-ovfs" in name_lower:
                    continue
                if p.name in seen_ff_profiles:
                    continue
                uc = p / "chrome" / "userChrome.css"
                if uc.exists():
                    match = re.search(r"rgba\(\d+,\s*\d+,\s*\d+,\s*([\d.]+)\)", uc.read_text(encoding="utf-8"))
                    if match:
                        print(f"  - Firefox ({p.name}) Opacity: {match.group(1)}")
                        seen_ff_profiles.add(p.name)
                elif (p / "prefs.js").exists() or (p / "compatibility.ini").exists() or "default" in name_lower:
                    print(f"  - Firefox ({p.name}) Opacity: Not configured (run set-opacity to apply)")
                    seen_ff_profiles.add(p.name)

    # Check Zen Browser
    zen_dir = CONFIG_DIR / "zen"
    if zen_dir.exists():
        for p in zen_dir.iterdir():
            uc = p / "chrome" / "userChrome.css"
            if uc.exists():
                match = re.search(r"rgba\(\d+,\s*\d+,\s*\d+,\s*([\d.]+)\)", uc.read_text(encoding="utf-8"))
                if match:
                    print(f"  - Zen Browser ({p.name}) Opacity: {match.group(1)}")

    # Check Alacritty
    alacritty_toml = CONFIG_DIR / "alacritty" / "alacritty.toml"
    if alacritty_toml.exists():
        match = re.search(r"opacity\s*=\s*([\d.]+)", alacritty_toml.read_text(encoding="utf-8"))
        if match:
            print(f"  - Alacritty Opacity: {match.group(1)}")



def install_script():
    """Installs set-opacity to ~/.local/bin/set-opacity."""
    local_bin = Path.home() / ".local" / "bin"
    local_bin.mkdir(parents=True, exist_ok=True)
    target = local_bin / "set-opacity"

    current_script = Path(__file__).resolve()
    shutil.copy2(current_script, target)
    target.chmod(0o755)
    print(f"Successfully installed 'set-opacity' to {target}")
    if str(local_bin) not in os.environ.get("PATH", ""):
        print("Note: Ensure ~/.local/bin is in your PATH.")


def main():
    parser = argparse.ArgumentParser(
        description="Unified Window Background Transparency Manager for CachyOS + Niri/Hyprland + DMS + VS Code + Firefox",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  set-opacity 0.85          Set background opacity to 85% for all windows, GTK, terminals, VS Code & Firefox
  set-opacity 75%           Set background opacity using percentage
  set-opacity translucent   Use preset (0.75)
  set-opacity opaque        Set to fully opaque (1.0)
  set-opacity --status      Show current opacity settings
  set-opacity 0.80 --dry-run Preview configuration updates
  set-opacity --install     Install script to ~/.local/bin/set-opacity
        """
    )

    parser.add_argument("opacity", nargs="?", help="Opacity value (float 0.0-1.0, percentage e.g. 85%%, or preset name)")
    parser.add_argument("-n", "--dry-run", action="store_true", help="Preview changes without modifying files")
    parser.add_argument("-s", "--status", action="store_true", help="Display current opacity settings")
    parser.add_argument("--install", action="store_true", help="Install set-opacity to ~/.local/bin/")

    args = parser.parse_args()

    if args.install:
        install_script()
        sys.exit(0)

    if args.status:
        get_status()
        sys.exit(0)

    if not args.opacity:
        parser.print_help()
        sys.exit(1)

    opacity = parse_opacity_value(args.opacity)
    print(f"Setting window background opacity to: {opacity:.2f} ({int(opacity * 100)}%)")

    updated_targets = []

    # Apply updates to Niri, Hyprland, GTK, VS Code, Firefox, Zen Browser & Terminals
    niri_res = update_niri(opacity, args.dry_run)
    if niri_res:
        updated_targets.append(niri_res)

    hypr_res = update_hyprland(opacity, args.dry_run)
    if hypr_res:
        updated_targets.append(hypr_res)

    updated_targets.extend(update_gtk_css(opacity, args.dry_run))
    updated_targets.extend(update_vscode(opacity, args.dry_run))
    updated_targets.extend(update_firefox(opacity, args.dry_run))
    updated_targets.extend(update_zen_browser(opacity, args.dry_run))

    for handler in [update_kitty, update_alacritty, update_foot, update_ghostty, update_wezterm]:
        res = handler(opacity, args.dry_run)
        if res:
            updated_targets.append(res)

    print("\nUpdated targets:")
    for target in updated_targets:
        print(f"  - {target}")

    if not args.dry_run:
        print("\nOpacity updated successfully!")


if __name__ == "__main__":
    main()
