    for zdir in zen_dirs:
        if not zdir.exists():
            continue

        for item in zdir.iterdir():
            if item.is_dir() and ((item / "chrome").exists() or (item / "prefs.js").exists()):
                # 1. Update user.js to ensure legacyUserProfileCustomizations.stylesheets is enabled
                user_js = item / "user.js"
                user_js_existing = user_js.read_text(encoding="utf-8") if user_js.exists() else ""
                js_pattern = re.compile(rf"{re.escape(MARKER_HASH_START)}.*?{re.escape(MARKER_HASH_END)}", re.DOTALL)
                
                if js_pattern.search(user_js_existing):
                    new_user_js = js_pattern.sub(lambda _: user_js_snippet, user_js_existing)
                else:
                    new_user_js = (user_js_existing.strip() + "\n\n" + user_js_snippet).strip() + "\n"
                
                write_file_safe(user_js, new_user_js, dry_run)

                # 2. Update userChrome.css
                chrome_dir = item / "chrome"
                user_chrome = chrome_dir / "userChrome.css"
                
                existing = user_chrome.read_text(encoding="utf-8") if user_chrome.exists() else ""
                pattern = re.compile(rf"{re.escape(MARKER_START)}.*?{re.escape(MARKER_END)}", re.DOTALL)
                clean_css = pattern.sub("", existing).strip()

                new_css = (clean_css + "\n\n" + css_content).strip() + "\n"
                if write_file_safe(user_chrome, new_css, dry_run):
                    updated.append(f"Zen Browser ({item.name})")

    return updated


