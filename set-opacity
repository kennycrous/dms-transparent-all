        match = re.search(r"opacity\s+([\d.]+)", niri_rules.read_text(encoding="utf-8"))
        if match:
            print(f"  - Niri Global Window Rule Opacity: {match.group(1)}")
        else:
            print("  - Niri Opacity: Default (No custom window rule)")

    # Check Hyprland
    hypr_rules = CONFIG_DIR / "hypr" / "dms" / "opacity.lua"
    if hypr_rules.exists():
