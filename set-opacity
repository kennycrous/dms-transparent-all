# ==========================================
# ALACRITTY HANDLER
# ==========================================
def update_alacritty(opacity: float, dry_run: bool = False) -> Optional[str]:
    alacritty_dir = CONFIG_DIR / "alacritty"
    if not alacritty_dir.exists():
        return None

    alacritty_toml = alacritty_dir / "alacritty.toml"
    existing = alacritty_toml.read_text(encoding="utf-8") if alacritty_toml.exists() else ""
    alpha_str = f"{opacity:.2f}"

    marker_pattern = re.compile(rf"{re.escape(MARKER_HASH_START)}.*?{re.escape(MARKER_HASH_END)}", re.DOTALL)

    if marker_pattern.search(existing):
        new_content = marker_pattern.sub(f"{MARKER_HASH_START}\n# Opacity updated by set-opacity\n{MARKER_HASH_END}", existing)
    else:
        new_content = existing

    if re.search(r"^\s*opacity\s*=", new_content, re.MULTILINE):
        new_content = re.sub(r"^\s*opacity\s*=.*$", f"opacity = {alpha_str}", new_content, flags=re.MULTILINE)
    elif "[window]" in new_content:
        new_content = re.sub(r"(\[window\])", rf"\1\nopacity = {alpha_str}", new_content, count=1)
    else:
        new_content = new_content.strip() + f"\n\n[window]\nopacity = {alpha_str}\n"

    write_file_safe(alacritty_toml, new_content, dry_run)
    return "Alacritty"


